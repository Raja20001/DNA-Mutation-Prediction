# DNA_v2 Platform Environment Variables
# Copy this file to .env and configure local settings

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production

# External API Integrations (Optional)
# NCBI Entrez API key for increased rate limits (10 req/s instead of 3 req/s)
NCBI_API_KEY=

# Ensembl REST API base URL
ENSEMBL_REST_URL=https://rest.ensembl.org

# Reproducibility & Computing
RANDOM_SEED=42
NUM_QUBITS=4
QISKIT_SIMULATOR=aer_simulator
